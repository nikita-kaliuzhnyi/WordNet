{"data":{"content":"package main;\n\nimport java.util.HashMap;\nimport java.util.HashSet;\nimport java.util.Map;\nimport java.util.Set;\n\npublic class Graph {\n    private Map<Integer, Set<Integer>> adjList;\n\n//     I don't see a need in the constructor for now\n    public Graph() {\n        adjList = new HashMap<>();\n    }\n\n    public void addVertex(int v) {\n        if (!adjList.containsKey(v)) {\n            adjList.put(v, new HashSet<Integer>());\n        }\n    }\n\n    public void addEdge(int parent, int child) {\n        addVertex(parent);\n        addVertex(child);\n\n        adjList.get(parent).add(child);\n    }\n\n    public Set<Integer> adj(int v) {\n        return adjList.get(v);\n    }\n\n    // the reason I called it dfs is because this type of\n    // traversal explores a graph by following one path\n    // as deeply as possible before backtracking\n    // could've called it traverse also\n    private void traverse(int v, Set<Integer> marked) {\n        marked.add(v);\n        for (Integer neighbor : adj(v)) {\n            if (!marked.contains(neighbor)) {\n                traverse(neighbor, marked);\n            }\n        }\n    }\n\n    public Set<Integer> reachable(int v) {\n        Set<Integer> marked = new HashSet<>();\n        traverse(v, marked);\n        return marked;\n    }\n}\n","line_count":52,"path":"src/main/Graph.java","sha256":"589f16a0285f54e58833233227b375cc110577a53205d72722d79bae75231085"},"hash":"b4ac0387975ea174e8612cf441318960be95b56281834e2ae26b778835eb97c2","kind":"doc.open","prev_hash":"33d8b59e869b73ecc3743012e533a32a70e45abfd922589d30a8d5912f24ba1b","seq":12,"t":1080,"wall":"2026-10-29T18:30:19.938Z"}
{"data":{"content":"package main;\n\nimport edu.princeton.cs.algs4.In;\n\nimport java.util.*;\n\npublic class WordNet {\n    private Graph graph;\n    private Map<String, Set<Integer>> wordToIds;\n    private Map<Integer, Set<String>> idToWords;\n\n    public WordNet(String synsetsFile, String hyponymsFile) {\n        graph = new Graph();\n        wordToIds = new HashMap<>();\n        idToWords = new HashMap<>();\n\n        In synsetsIn = new In(synsetsFile);\n\n        while(!synsetsIn.isEmpty()) {\n            String line = synsetsIn.readLine();\n            String[] parts = line.split(\",\");\n\n            int id = Integer.parseInt(parts[0]);\n            String[] words = parts[1].split(\" \");\n\n            graph.addVertex(id);\n\n            Set<String> words_set = new HashSet<>();\n            for (String word : words) {\n                words_set.add(word);\n                if (!wordToIds.containsKey(word)) {\n                    wordToIds.put(word, new HashSet<Integer>());\n                }\n                wordToIds.get(word).add(id);\n            }\n            idToWords.put(id, words_set);\n        }\n\n        In hyponymsIn = new In(hyponymsFile);\n\n        while(!hyponymsIn.isEmpty()) {\n            String line = hyponymsIn.readLine();\n            String[] parts = line.split(\",\");\n\n            int parent = Integer.parseInt(parts[0]);\n            for (int i = 1; i < parts.length; i++) {\n                int child = Integer.parseInt(parts[i]);\n                graph.addEdge(parent, child);\n            }\n        }\n    }\n\n    public Set<String> hyponyms(String word) {\n        Set<Integer> reachableIds = new HashSet<>();\n        Set<String> hyponyms = new TreeSet<>();\n\n        for (Integer id : wordToIds.get(word)) {\n            reachableIds.addAll(graph.reachable(id));\n        }\n\n        for (Integer id : reachableIds) {\n            hyponyms.addAll(idToWords.get(id));\n        }\n\n        return hyponyms;\n    }\n}\n","line_count":68,"path":"src/main/WordNet.java","sha256":"f64c72e60603d33ed5e4574294a6430a066593ff2743519bf2bd1ff22d5b733e"},"hash":"cd350aecb085eabd6cb8a596badfc350033eeb544f197bdd764dab9cef441590","kind":"doc.open","prev_hash":"b4ac0387975ea174e8612cf441318960be95b56281834e2ae26b778835eb97c2","seq":13,"t":1081,"wall":"2026-10-29T18:30:19.938Z"}
{"data":{"content":"import browser.NgordnetQuery;\nimport browser.NgordnetQueryHandler;\nimport org.junit.jupiter.api.Test;\nimport main.AutograderBuddy;\n\nimport java.util.ArrayList;\nimport java.util.List;\n\nimport static com.google.common.truth.Truth.assertThat;\n\n/**\n * Tests the most basic case for Hyponyms where the list of words is one word long, and k = 0.\n * The word history and year history files do not matter for the k==0 case, but are provided\n * as input for the constructor of the HyponymsHandler.\n */\npublic class TestOneWordK0Hyponyms {\n    private static final String PREFIX = \"./data/\";\n\n    /** NGrams Files */\n    public static final String WORD_HISTORY_EECS_FILE = PREFIX + \"word_history_eecs.csv\";\n    public static final String WORD_HISTORY_SIZE3_FILE = PREFIX + \"word_history_size3.csv\";\n    public static final String WORD_HISTORY_SIZE4_FILE = PREFIX + \"word_history_size4.csv\";\n    public static final String WORD_HISTORY_SIZE1291_FILE = PREFIX + \"word_history_size1291.csv\";\n    public static final String WORD_HISTORY_SIZE14377_FILE = PREFIX + \"word_history_size14377.csv\";\n    public static final String YEAR_HISTORY_FILE = PREFIX + \"year_history.csv\";\n\n    /** Wordnet Files */\n    public static final String SYNSETS_EECS_FILE = PREFIX + \"synsets_eecs.txt\";\n    public static final String HYPONYMS_EECS_FILE = PREFIX + \"hyponyms_eecs.txt\";\n    public static final String SYNSET_SIZE16_FILE = PREFIX + \"synsets_size16.txt\";\n    public static final String HYPONYM_SIZE16_FILE = PREFIX + \"hyponyms_size16.txt\";\n    public static final String SYNSET_SIZE1000_FILE = PREFIX + \"synsets_size1000.txt\";\n    public static final String HYPONYM_SIZE1000_FILE = PREFIX +  \"hyponyms_size1000.txt\";\n\n    @Test\n    public void testActK0() {\n        NgordnetQueryHandler studentHandler = AutograderBuddy.getHyponymsHandler(\n                WORD_HISTORY_SIZE3_FILE, YEAR_HISTORY_FILE, SYNSET_SIZE16_FILE, HYPONYM_SIZE16_FILE);\n        List<String> words = new ArrayList<>();\n        words.add(\"act\");\n\n        NgordnetQuery nq = new NgordnetQuery(words, 0, 0, 0);\n        String actual = studentHandler.handle(nq);\n        String expected = \"[act, action, change, demotion, human_action, human_activity, variation]\";\n        assertThat(actual).isEqualTo(expected);\n    }\n\n    // TODO: Add more unit tests (including edge case tests) here.\n}\n","line_count":50,"path":"tests/TestOneWordK0Hyponyms.java","sha256":"3e7259467d2a3f7c7a1d5318731561dbf377e877650ee8d22f3c5307caa3002c"},"hash":"30f34a13ee7ab737d4aa4bc8436207c42908d6c8dca04f482cfc2dee94d8c906","kind":"doc.open","prev_hash":"cd350aecb085eabd6cb8a596badfc350033eeb544f197bdd764dab9cef441590","seq":14,"t":1081,"wall":"2026-10-29T18:30:19.938Z"}
