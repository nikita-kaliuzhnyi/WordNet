{"data":{"content":"package main;\n\nimport browser.NgordnetServer;\nimport org.slf4j.LoggerFactory;\n// Feel free to copy over your handlers from 4A and import them here!\n\npublic class Main {\n    private static final String PREFIX = \"./data/\";\n\n    /** NGrams Files */\n    private static final String WORD_HISTORY_EECS_FILE = PREFIX + \"word_history_eecs.csv\";\n    public static final String WORD_HISTORY_SIZE3_FILE = PREFIX + \"word_history_size3.csv\";\n    public static final String WORD_HISTORY_SIZE4_FILE = PREFIX + \"word_history_size4.csv\";\n    public static final String WORD_HISTORY_SIZE1291_FILE = PREFIX + \"word_history_size1291.csv\";\n    public static final String WORD_HISTORY_SIZE14377_FILE = PREFIX + \"word_history_size14377.csv\";\n    public static final String YEAR_HISTORY_FILE = PREFIX + \"year_history.csv\";\n\n    /** Wordnet Files */\n    private static final String SYNSETS_EECS_FILE = PREFIX + \"synsets_eecs.txt\";\n    private static final String HYPONYMS_EECS_FILE = PREFIX + \"hyponyms_eecs.txt\";\n    public static final String SYNSETS_SIZE16_FILE = PREFIX + \"synsets_size16.txt\";\n    public static final String HYPONYMS_SIZE16_FILE = PREFIX + \"hyponyms_size16.txt\";\n    public static final String SYNSETS_SIZE1000_FILE = PREFIX + \"synsets_size1000.txt\";\n    public static final String HYPONYMS_SIZE1000_FILE = PREFIX +  \"hyponyms_size1000.txt\";\n    public static final String SYNSETS_SIZE82191_FILE = PREFIX + \"synsets_size82191.txt\";\n    public static final String HYPONYMS_SIZE82191_FILE = PREFIX +  \"hyponyms_size82191.txt\";\n\n\n    static {\n        LoggerFactory.getLogger(Main.class).info(\"\\033[1;38mChanging text color to white\");\n    }\n    public static void main(String[] args) {\n        NgordnetServer hns = new NgordnetServer();\n\n//        NGramMap ngm = new NGramMap(WORD_HISTORY_SIZE14377_FILE, YEAR_HISTORY_FILE);\n\n        hns.register(\"hyponyms\", new HyponymsHandler());\n//        hns.register(\"history\", new Historyhandler(ngm));\n//        hns.register(\"historytext\", new HistoryTextHandler(ngm));\n        hns.startUp();\n\n        System.out.println(\"Finished server startup! Visit http://localhost:4567/ngordnet.html\");\n    }\n}","line_count":44,"path":"src/main/Main.java","sha256":"a4b9556d9477c0555aab805e83dec764250b18c39c76b6569911bf4652671aa1"},"hash":"1d32c83dfb906556283cc1715509c17cfd8bfad85453a7a8ec653e45ad54c04a","kind":"doc.open","prev_hash":"06acc65897821430d4c65acd31123e5c7c774eb10207dad18d80ff21f15047fd","seq":10,"t":63,"wall":"2026-10-29T02:54:48.208Z"}
{"data":{"content":"package main;\n\nimport java.util.HashMap;\nimport java.util.HashSet;\nimport java.util.Map;\nimport java.util.Set;\n\npublic class Graph {\n    private Map<Integer, Set<Integer>> adjList = new HashMap<>();\n\n//     I don't see a need in the constructor for now\n//    public Graph() {\n//\n//    }\n\n    public void addVertex(int v) {\n        if (!adjList.containsKey(v)) {\n            adjList.put(v, new HashSet<Integer>());\n        }\n    }\n\n    public void addEdge(int parent, int child) {\n        addVertex(parent);\n        addVertex(child);\n\n        adjList.get(parent).add(child);\n    }\n\n    public Set<Integer> adj(int v) {\n        return adjList.get(v);\n    }\n\n    // the reason I called it dfs is because this type of\n    // traversal explores a graph by following one path\n    // as deeply as possible before backtracking\n    // could've called it traverse also\n    private void dfs(int v, Set<Integer> marked) {\n        marked.add(v);\n        for (Integer neighbor : adj(v)) {\n            if (!marked.contains(neighbor)) {\n                dfs(neighbor, marked);\n            }\n        }\n    }\n\n    public Set<Integer> reacheble(int v) {\n        Set<Integer> marked = new HashSet<>();\n        dfs(v, marked);\n        return marked;\n    }\n}\n","line_count":52,"path":"src/main/Graph.java","sha256":"c91397657e4051cc0f5c8a0ca83dcfe17fbdd7ac63e70b82cf3b6ddb29896ac1"},"hash":"e55b0cf6ac585db284b84dd3432ddf1a7a39235a99659a92a4a0e6f220069cbc","kind":"doc.open","prev_hash":"1d32c83dfb906556283cc1715509c17cfd8bfad85453a7a8ec653e45ad54c04a","seq":11,"t":64,"wall":"2026-10-29T02:54:48.209Z"}
