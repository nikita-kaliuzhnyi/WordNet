{"data":{"content":"package main;\n\nimport java.util.HashMap;\nimport java.util.HashSet;\nimport java.util.Map;\nimport java.util.Set;\n\npublic class Graph {\n    private Map<Integer, Set<Integer>> adjList = new HashMap<>();\n\n//     I don't see a need in the constructor for now\n//    public Graph() {\n//\n//    }\n\n    public void addVertex(int v) {\n        if (!adjList.containsKey(v)) {\n            adjList.put(v, new HashSet<Integer>());\n        }\n    }\n\n    public void addEdge(int parent, int child) {\n        addVertex(parent);\n        addVertex(child);\n\n        adjList.get(parent).add(child);\n    }\n\n    public Set<Integer> adj(int v) {\n        addVertex(v);\n        return adjList.get(v);\n    }\n\n    \n}\n","line_count":36,"path":"src/main/Graph.java","sha256":"fcec89a4ed692a9cdede92e91d471c52b2059e5428f515d805bc17d081b09561"},"hash":"b8b17f963b73c197e0fba6402c6025254fb5bc08d42b0acee1f3c297a1d7998e","kind":"doc.open","prev_hash":"20a39bf91c4df58db23b61413859a2261d0fe305799da55c49db09118b675fcf","seq":21,"t":107507,"wall":"2026-10-27T06:43:48.784Z"}
