{"data":{"content":"package main;\n\nimport java.util.HashMap;\nimport java.util.HashSet;\nimport java.util.Map;\nimport java.util.Set;\n\npublic class Graph {\n    private Map<Integer, Set<Integer>> adjList;\n\n//     I don't see a need in the constructor for now\n    public Graph() {\n        adjList = new HashMap<>();\n    }\n\n    public void addVertex(int v) {\n        if (!adjList.containsKey(v)) {\n            adjList.put(v, new HashSet<Integer>());\n        }\n    }\n\n    public void addEdge(int parent, int child) {\n        addVertex(parent);\n        addVertex(child);\n\n        adjList.get(parent).add(child);\n    }\n\n    public Set<Integer> adj(int v) {\n        return adjList.get(v);\n    }\n\n    // the reason I called it dfs is because this type of\n    // traversal explores a graph by following one path\n    // as deeply as possible before backtracking\n    // could've called it traverse also\n    private void traverse(int v, Set<Integer> marked) {\n        marked.add(v);\n        for (Integer neighbor : adj(v)) {\n            if (!marked.contains(neighbor)) {\n                traverse(neighbor, marked);\n            }\n        }\n    }\n\n    public Set<Integer> reachable(int v) {\n        Set<Integer> marked = new HashSet<>();\n        traverse(v, marked);\n        return marked;\n    }\n}\n","line_count":52,"path":"src/main/Graph.java","sha256":"589f16a0285f54e58833233227b375cc110577a53205d72722d79bae75231085"},"hash":"28b2137462e2d68e45ff7d52bd2a4e3b7a8091c3b7c50f3795fff732ef2e1ae2","kind":"doc.open","prev_hash":"3034e9f2c5ecd3f9f284a7bc10ee57a9b083bd217d0e7d6a0581b1f31e2b043b","seq":14,"t":46,"wall":"2026-10-30T20:40:38.276Z"}
{"data":{"content":"package main;\n\nimport edu.princeton.cs.algs4.In;\n\nimport java.util.*;\n\npublic class WordNet {\n    private Graph graph;\n    private Map<String, Set<Integer>> wordToIds;\n    private Map<Integer, Set<String>> idToWords;\n\n    public WordNet(String synsetsFile, String hyponymsFile) {\n        graph = new Graph();\n        wordToIds = new HashMap<>();\n        idToWords = new HashMap<>();\n\n        In synsetsIn = new In(synsetsFile);\n\n        while (!synsetsIn.isEmpty()) {\n            String line = synsetsIn.readLine();\n            String[] parts = line.split(\",\");\n\n            int id = Integer.parseInt(parts[0]);\n            String[] words = parts[1].split(\" \");\n\n            graph.addVertex(id);\n\n            Set<String> wordsSet = new HashSet<>();\n            for (String word : words) {\n                wordsSet.add(word);\n                if (!wordToIds.containsKey(word)) {\n                    wordToIds.put(word, new HashSet<Integer>());\n                }\n                wordToIds.get(word).add(id);\n            }\n            idToWords.put(id, wordsSet);\n        }\n\n        In hyponymsIn = new In(hyponymsFile);\n\n        while (!hyponymsIn.isEmpty()) {\n            String line = hyponymsIn.readLine();\n            String[] parts = line.split(\",\");\n\n            int parent = Integer.parseInt(parts[0]);\n            for (int i = 1; i < parts.length; i++) {\n                int child = Integer.parseInt(parts[i]);\n                graph.addEdge(parent, child);\n            }\n        }\n    }\n\n    public Set<String> hyponyms(String word) {\n        Set<Integer> reachableIds = new HashSet<>();\n        Set<String> hyponyms = new TreeSet<>();\n\n        if (!wordToIds.containsKey(word)) {\n            return hyponyms;\n        }\n\n        for (Integer id : wordToIds.get(word)) {\n            reachableIds.addAll(graph.reachable(id));\n        }\n\n        for (Integer id : reachableIds) {\n            hyponyms.addAll(idToWords.get(id));\n        }\n\n        return hyponyms;\n    }\n\n    // Overloading\n    public Set<String> hyponyms(List<String> words) {\n        Set<String> result = new TreeSet<>();\n\n        if (words.isEmpty()) {\n            return result;\n        }\n\n        // because intersection of {...} and {} is {}, we have to populate empty\n        // set before intersecting with the rest\n        result.addAll(this.hyponyms(words.get(0)));\n\n        for (int i = 1; i < words.size(); i++) {\n            result.retainAll(this.hyponyms(words.get(i)));\n        }\n\n        return result;\n    }\n}\n","line_count":91,"path":"src/main/WordNet.java","sha256":"badd6445ff5a32f99c48d142901b781703ad06c7cbc9f3627d0fe7d9e045baf0"},"hash":"8b143623216f3c984b1c2bde285ffdd492ab5193c830ff2805e5fb9077dab49b","kind":"doc.open","prev_hash":"28b2137462e2d68e45ff7d52bd2a4e3b7a8091c3b7c50f3795fff732ef2e1ae2","seq":15,"t":46,"wall":"2026-10-30T20:40:38.276Z"}
