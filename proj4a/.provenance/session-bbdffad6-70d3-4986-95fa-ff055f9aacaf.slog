{"data":{"content":"package demo;\n\nimport edu.princeton.cs.algs4.In;\n\nimport static main.Main.*;\n\npublic class FileReadDemo {\n    public static void main(String[] args) {\n        In in = new In(WORD_HISTORY_SIZE3_FILE);\n        int i = 0;\n\n        while (!in.isEmpty()) {\n            i += 1;\n            String nextLine = in.readLine();\n            System.out.print(\"Line \" + i + \" is: \");\n            System.out.println(nextLine);\n            System.out.print(\"After splitting on tab characters, the first word is: \");\n            String[] splitLine = nextLine.split(\"\\t\");\n            System.out.println(splitLine[0]);\n        }\n    }\n}\n","line_count":23,"path":"src/demo/FileReadDemo.java","sha256":"69ed25d6be6883c13b244b838c6b73cca3a2ae2b36a9a6abed17f033b739b44c"},"hash":"0cd8834b4efae2de0ec5c111943c0df5fb9cb3f652b85a528dff54c621322952","kind":"doc.open","prev_hash":"cb618158bbf635b807d611253987f54c1870d268dc915d30d33567657ae5a3ef","seq":110,"t":667528,"wall":"2026-10-14T00:59:36.244Z"}
{"data":{"content":"// This should say \"package main\" in your own HistoryTextHandler.java,\n// since your file will be in the \"main\" package.\npackage demo;\n\nimport browser.NgordnetQuery;\nimport browser.NgordnetQueryHandler;\n\nimport java.util.List;\n\npublic class DummyHistoryTextHandler extends NgordnetQueryHandler {\n    @Override\n    public String handle(NgordnetQuery q) {\n        List<String> words = q.words();\n        int startYear = q.startYear();\n        int endYear = q.endYear();\n\n        String response = \"You entered the following info into the browser:\\n\";\n        response += \"Words: \" + q.words() + \"\\n\";\n        response += \"Start Year: \" + q.startYear() + \"\\n\";\n        response += \"End Year: \" + q.endYear() + \"\\n\";\n        return response;\n    }\n}\n","line_count":24,"path":"src/demo/DummyHistoryTextHandler.java","sha256":"abbcb140f4e6278632753768d15ab283aa0bf983227073d16910d3b13cc4ceb7"},"hash":"8f1be56dd82945da8c9fd150a751c92374574113d4263c9dfdc6ff05dafdc891","kind":"doc.open","prev_hash":"0cd8834b4efae2de0ec5c111943c0df5fb9cb3f652b85a528dff54c621322952","seq":111,"t":668114,"wall":"2026-10-14T00:59:36.830Z"}
