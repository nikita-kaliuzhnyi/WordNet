{"data":{"content":"package demo;\n\nimport edu.princeton.cs.algs4.In;\n\nimport static main.Main.*;\n\npublic class FileReadDemo {\n    public static void main(String[] args) {\n        In in = new In(WORD_HISTORY_SIZE3_FILE);\n        int i = 0;\n\n        while (!in.isEmpty()) {\n            i += 1;\n            String nextLine = in.readLine();\n            System.out.print(\"Line \" + i + \" is: \");\n            System.out.println(nextLine);\n            System.out.print(\"After splitting on tab characters, the first word is: \");\n            String[] splitLine = nextLine.split(\"\\t\");\n            System.out.println(splitLine[0]);\n        }\n    }\n}\n","line_count":23,"path":"src/demo/FileReadDemo.java","sha256":"69ed25d6be6883c13b244b838c6b73cca3a2ae2b36a9a6abed17f033b739b44c"},"hash":"fc418618c9ca441333f52ab36e59bc4a2135df5d7daa854acad52863cac1b92d","kind":"doc.open","prev_hash":"de17d70b0e2d2f977a550fc4e3ae46719bd0fc0efe45ebe8097cc69eb0864981","seq":4612,"t":8119696,"wall":"2026-10-13T06:08:03.522Z"}
