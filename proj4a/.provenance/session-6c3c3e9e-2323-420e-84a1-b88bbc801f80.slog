{"data":{"content":"// Read the word history file\n    In in = new In(wordHistoryFilename);\n\n    while (!in.isEmpty()) {\n        String line = in.readLine();\n        String[] parts = line.split(\"\\t\");\n\n        String word = parts[0];\n        int year = Integer.parseInt(parts[1]);\n        double count = Double.parseDouble(parts[2]);\n\n        if (!wordHistory.containsKey(word)) {\n            wordHistory.put(word, new TimeSeries());\n        }\n\n        wordHistory.get(word).put(year, count);\n    }\n","length":478,"path":"src/main/NGramMap.java","range":{"end":{"character":8,"line":31},"start":{"character":8,"line":31}},"sha256":"794986183ee1a0d35e64d2c9ef5a4fa0558653621f9af7f35b061f773ad6b191"},"hash":"ec4b6c225322fa484fd49a6384664c017b5dd10cdb47d5518782df6f0b57a44c","kind":"paste","prev_hash":"c879d453fa331a5ab9f3997c4784f23e9dade0d6b4e803f331e9007e07e8529d","seq":5753,"t":11836415,"wall":"2026-10-13T07:46:12.615Z"}
