{"data":{"content":"// Read the year history file\n    In yearIn = new In(yearHistoryFilename);\n\n    while (!yearIn.isEmpty()) {\n        String line = yearIn.readLine();\n        String[] parts = line.split(\",\");\n\n        int year = Integer.parseInt(parts[0]);\n        double totalCount = Double.parseDouble(parts[1]);\n\n        totalHistory.put(year, totalCount);\n    }","length":347,"path":"src/main/NGramMap.java","range":{"end":{"character":8,"line":50},"start":{"character":8,"line":50}},"sha256":"acabba8ecdac28c6f33acf0b50ea2440b8e80e629e3e9bbb6c853715ee2f2b24"},"hash":"a882894a3271c246809f8384d0cea7d27efec7c71092c695b6c97678acb3895a","kind":"paste","prev_hash":"b7d4507599d08b3ede32b10ba23f1d202c5a7d2bef02d4cc1217dcb5382b3faf","seq":6238,"t":11982361,"wall":"2026-10-13T07:48:38.560Z"}
